if op == "+":
  resultado_sum=num1+num2
  print(f"El resultado es {resultado_sum} ")

if op == "-":
  resultado_resta=num1-num2
  print(f"El resultado es {resultado_resta} ")
  
if op == "*":
  resultado_mult=num1*num2
  print(f"El resultado es {resultado_mult} ")

