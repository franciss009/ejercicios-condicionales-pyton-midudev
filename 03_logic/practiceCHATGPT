# Encontrar numero mayor
def encontrar_mayor(numeros):
    mayor = numeros[0]

    for numero in numeros:
        if numero > mayor:
            mayor = numero
    return mayor

numeros = [14, 7, 32, 5, 21, 48, 9]
print(encontrar_mayor(numeros))


