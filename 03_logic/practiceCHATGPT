# Procesar pedidos

pedidos = [
    {"producto": "camiseta", "precio": 25, "cantidad": 2},
    {"producto": "zapatillas", "precio": 70, "cantidad": 1},
    {"producto": "gorra", "precio": 15, "cantidad": 3},
    {"producto": "pantalon", "precio": 40, "cantidad": 2}
]


def calcular_pedidos(pedidos):
    vendido = 0

    for pedido in pedidos:
        vendido += pedido["precio"] * pedido["cantidad"]
    return vendido

print(calcular_pedidos(pedidos))
