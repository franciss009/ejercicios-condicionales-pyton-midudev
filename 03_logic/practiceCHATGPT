# Control de acceso

usuarios = {
    "fran": {"edad": 21, "activo": True},
    "ana": {"edad": 17, "activo": True},
    "pablo": {"edad": 25, "activo": False},
    "lucia": {"edad": 19, "activo": True}
}

def pueden_entrar(usuarios):
    permitidos = [] 

    for usuario in usuarios:
        if usuarios[usuario]["edad"] >= 18 and usuarios[usuario]["activo"] == True:
            permitidos.append(usuario)
    return permitidos

print(pueden_entrar(usuarios))


