# Contar aprobados
def contar_aprobados(notas):
    count = 0

    for nota in notas:
        if nota >= 5:
            count += 1
    return count

notas = [7, 4, 8, 3, 5, 9, 2]
print(f"Hay: {contar_aprobados(notas)} aprobados")


